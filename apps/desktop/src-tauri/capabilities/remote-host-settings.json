{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-host-settings",
  "description": "Let Settings manage SSH hosts, automatic scan frequency, and session scan status.",
  "windows": ["settings"],
  "permissions": [
    "allow-get-remote-hosts",
    "allow-set-remote-hosts",
    "allow-get-remote-sessions",
    "allow-get-remote-sync-status",
    "allow-set-remote-sync-interval"
  ]
}
